{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/relay/Dockerfile",
    "watchPatterns": ["apps/relay/**", "crates/dray-relay/**"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "overlapSeconds": 0,
    "drainingSeconds": 5,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
