<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  For the five `Dray Helper` apps CEF runs its renderer, GPU, plugin and
  alert processes in. Signed by scripts/cef-helpers.sh, not by Tauri's
  bundler, which knows nothing about them.

  Library validation is off for the same reason as the app's: the framework
  they load is downloaded after install and only ad-hoc signed. JIT and
  unsigned executable memory are what V8 needs in the renderer under the
  hardened runtime — Chrome's own helper entitlements carry both.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
