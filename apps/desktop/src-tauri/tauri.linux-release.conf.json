{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "dray-app",
  "bundle": {
    "publisher": "Dray",
    "category": "DeveloperTool",
    "shortDescription": "Desktop app for coding agents",
    "externalBin": ["target/cli/dray-cli", "target/island-linux/dray-island"],
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.35)",
          "ca-certificates",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "libasound2t64 | libasound2",
          "libxkbcommon0",
          "libxkbcommon-x11-0",
          "libvulkan1",
          "libnspr4",
          "libnss3",
          "libatk1.0-0t64 | libatk1.0-0",
          "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
          "libatspi2.0-0t64 | libatspi2.0-0",
          "libxcomposite1",
          "libxdamage1",
          "libxfixes3",
          "libxrandr2",
          "libgbm1",
          "fontconfig"
        ]
      }
    }
  }
}
