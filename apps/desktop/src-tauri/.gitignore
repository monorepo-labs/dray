# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# ts-rs default output, created when cargo runs outside src-tauri/ so
# .cargo/config.toml (which redirects to src/types) does not apply.
/bindings/

# Linux's shared libtranscribe and its backend modules, copied here by build.rs
# so the bundler can name them (tauri.linux.conf.json).
/transcribe-libs/
