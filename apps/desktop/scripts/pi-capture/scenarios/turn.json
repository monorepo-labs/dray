{
  "bin": "${PI_BIN}",
  "cwd": "${PROBE}/work",
  "args": ["--session", "${PROBE}/sessions/dray-turn.jsonl", "--thinking", "low"],
  "steps": [
    { "sleep": 2500 },
    { "send": { "id": "q0", "type": "get_state" }, "sleep": 600 },
    {
      "send": {
        "id": "p1",
        "type": "prompt",
        "message": "Read notes.txt, then create a file out.txt whose only content is the word ok. Then reply with one short sentence and stop."
      },
      "waitFor": { "type": "agent_settled" },
      "timeout": 180000
    },
    { "send": { "id": "q9", "type": "get_session_stats" }, "sleep": 1500 }
  ]
}
