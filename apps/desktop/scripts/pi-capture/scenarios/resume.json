{
  "bin": "${PI_BIN}",
  "cwd": "${PROBE}/work",
  "env": {
    "PI_CODING_AGENT_DIR": "${PROBE}/agentdir",
    "PI_OFFLINE": "1",
    "PATH": "${NODE_BIN}:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "args": [
    "--session",
    "${PROBE}/sessions/dray-tools.jsonl",
    "--provider",
    "stub",
    "--model",
    "stub-1",
    "--no-extensions",
    "--no-skills",
    "--no-context-files"
  ],
  "steps": [
    { "sleep": 3000 },
    { "send": { "id": "q0", "type": "get_state" }, "sleep": 1000 },
    { "send": { "id": "q1", "type": "get_session_stats" }, "sleep": 1000 },
    { "send": { "id": "q2", "type": "get_fork_messages" }, "sleep": 1000 },
    { "send": { "id": "q3", "type": "get_messages" }, "sleep": 1200 },
    { "send": { "id": "c1", "type": "compact" }, "sleep": 6000 },
    { "send": { "id": "q4", "type": "get_session_stats" }, "sleep": 1500 }
  ]
}
