{
  "bin": "${PI_BIN}",
  "cwd": "${PROBE}/work",
  "env": {
    "PI_CODING_AGENT_DIR": "${PROBE}/agentdir",
    "PI_OFFLINE": "1",
    "PATH": "${NODE_BIN}:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "args": [
    "--session",
    "${PROBE}/sessions/dray-errors.jsonl",
    "--provider",
    "stub",
    "--model",
    "stub-1",
    "--no-extensions",
    "--no-skills",
    "--no-context-files"
  ],
  "steps": [
    { "sleep": 3000 },
    { "send": { "id": "e1", "type": "no_such_command" }, "sleep": 700 },
    { "send": { "id": "e2", "type": "set_model", "provider": "nope", "modelId": "nope" }, "sleep": 700 },
    { "send": { "id": "e3", "type": "set_thinking_level", "level": "high" }, "sleep": 700 },
    { "send": { "id": "e4", "type": "get_available_thinking_levels" }, "sleep": 700 },
    { "send": { "id": "e5", "type": "get_entries" }, "sleep": 700 },
    { "send": { "id": "e6", "type": "set_auto_compaction", "enabled": false }, "sleep": 700 },
    { "send": { "id": "e7", "type": "prompt", "message": "Do the thing." }, "sleep": 1200 },
    { "send": { "id": "e8", "type": "prompt", "message": "second while streaming" }, "sleep": 1200 },
    { "send": { "id": "e9", "type": "clone" }, "sleep": 1500 },
    { "send": { "id": "e10", "type": "get_state" }, "sleep": 1500 }
  ]
}
