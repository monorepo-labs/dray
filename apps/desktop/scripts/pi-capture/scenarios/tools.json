{
  "bin": "${PI_BIN}",
  "cwd": "${PROBE}/work",
  "env": {
    "PI_CODING_AGENT_DIR": "${PROBE}/agentdir",
    "PI_OFFLINE": "1",
    "PATH": "${NODE_BIN}:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "args": [
    "--session",
    "${PROBE}/sessions/dray-tools.jsonl",
    "--provider",
    "stub",
    "--model",
    "stub-1",
    "--no-extensions",
    "--no-skills",
    "--no-context-files"
  ],
  "steps": [
    { "sleep": 2500 },
    { "send": { "id": "q0", "type": "get_state" }, "sleep": 800 },
    {
      "send": { "id": "p1", "type": "prompt", "message": "Do the thing." },
      "waitFor": { "type": "agent_settled" },
      "timeout": 90000
    },
    { "send": { "id": "q9", "type": "get_session_stats" }, "sleep": 1200 }
  ]
}
