{
  "bin": "${PI_BIN}",
  "cwd": "${PROBE}/work",
  "env": {
    "PI_CODING_AGENT_DIR": "${PROBE}/agentdir",
    "PI_OFFLINE": "1",
    "PATH": "${NODE_BIN}:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "args": [
    "--session",
    "${PROBE}/sessions/dray-approval.jsonl",
    "--provider",
    "stub",
    "--model",
    "stub-1",
    "--no-extensions",
    "--no-skills",
    "--no-context-files",
    "-e",
    "${PROBE}/agentdir/dray-approvals.ts"
  ],
  "steps": [
    { "sleep": 3000 },
    { "send": { "id": "p1", "type": "prompt", "message": "Do the thing." }, "sleep": 4000 },
    { "answerUi": { "confirmed": true }, "sleep": 4000 },
    { "answerUi": { "confirmed": false }, "sleep": 4000 },
    { "answerUi": { "cancelled": true }, "sleep": 4000 },
    { "answerUi": { "confirmed": true }, "waitFor": { "type": "agent_settled" }, "timeout": 40000 }
  ]
}
