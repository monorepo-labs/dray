{
  "bin": "${PI_BIN}",
  "cwd": "${PROBE}/work",
  "args": ["--session-dir", "${PROBE}/sessions"],
  "steps": [
    { "sleep": 2500 },
    { "send": { "id": "q1", "type": "get_state" }, "sleep": 800 },
    { "send": { "id": "q2", "type": "get_session_stats" }, "sleep": 800 },
    { "send": { "id": "q3", "type": "get_commands" }, "sleep": 800 },
    { "send": { "id": "q4", "type": "get_available_thinking_levels" }, "sleep": 800 },
    { "send": { "id": "q5", "type": "get_entries" }, "sleep": 800 },
    { "send": { "id": "q6", "type": "get_available_models" }, "sleep": 1500 }
  ]
}
